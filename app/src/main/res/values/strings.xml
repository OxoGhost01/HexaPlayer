    <!-- Termux setup guide -->
    <string name="back">Back</string>
    <string name="tx_title">Downloader setup</string>
    <string name="tx_intro">HexaPlayer downloads music with spotDL, a free tool that runs inside the Termux app on your phone. Nothing is sent to an outside server. You only do steps 1 to 3 once.</string>
    <string name="tx_step_1">Step 1</string>
    <string name="tx_install_title">Install Termux</string>
    <string name="tx_install_body">Download Termux from F-Droid (tap Download APK) or from GitHub (tap the file ending in universal.apk). Do not use the Play Store version, it does not work with this setup. Open Termux once after installing it and wait for it to finish preparing.</string>
    <string name="tx_install_fdroid">F-Droid</string>
    <string name="tx_install_github">GitHub</string>
    <string name="tx_installed">✓ Termux is installed</string>
    <string name="tx_not_installed">Termux is not installed yet</string>
    <string name="tx_step_2">Step 2</string>
    <string name="tx_command_title">Run the setup command</string>
    <string name="tx_command_body">Copy this command, paste it in Termux (long press, then Paste) and press Enter:</string>
    <string name="tx_command_wait">Tap Allow when Termux asks for storage access. The first install can take 10 to 30 minutes because some parts are built on your phone. Keep Termux open until it prints Done.</string>
    <string name="tx_command_button">Copy and open Termux</string>
    <string name="tx_termux_missing">Install Termux first (step 1)</string>
    <string name="tx_step_3">Step 3</string>
    <string name="tx_permission_title">Let HexaPlayer start Termux</string>
    <string name="tx_permission_body">With this permission, HexaPlayer starts the downloader in the background when you start a download, and it stops by itself after 10 minutes without downloads. Without it, you have to open Termux and type hexadl yourself each time.</string>
    <string name="tx_permission_button">Allow</string>
    <string name="tx_permission_granted">✓ Permission granted</string>
    <string name="tx_permission_missing">Permission not granted yet</string>
    <string name="tx_permission_denied">Permission denied. You can still type hexadl in Termux.</string>
    <string name="tx_step_4">Step 4</string>
    <string name="tx_start_title">Start the downloader</string>
    <string name="tx_start_body">Optional: start it now to check that everything works. Termux shows a notification while it runs; it stops by itself after 10 minutes without downloads.</string>
    <string name="tx_start_button">Start now</string>
    <string name="tx_start_manual">Open Termux and type hexadl, then come back</string>
    <string name="tx_tips_label">Tips</string>
    <string name="tx_tips_body">• If downloads stop when the screen is off, disable battery optimization for Termux in Android settings.\n• If the downloader says it cannot connect, run the setup command again: it is safe to repeat.\n• Music is saved in Music/HexaPlayer.</string>
    <string name="tx_full_guide">Full guide on GitHub</string>
