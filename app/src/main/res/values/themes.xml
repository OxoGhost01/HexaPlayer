<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HexaPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_purple_primary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_purple_secondary</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorText</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <style name="Theme.HexaPlayer.DeepPurple" parent="Theme.HexaPlayer">
        <item name="colorPrimary">@color/accent_deep_purple_primary</item>
        <item name="colorSecondary">@color/accent_deep_purple_secondary</item>
    </style>

    <style name="Theme.HexaPlayer.Blue" parent="Theme.HexaPlayer">
        <item name="colorPrimary">@color/accent_blue_primary</item>
        <item name="colorSecondary">@color/accent_blue_secondary</item>
    </style>

    <style name="Theme.HexaPlayer.Teal" parent="Theme.HexaPlayer">
        <item name="colorPrimary">@color/accent_teal_primary</item>
        <item name="colorSecondary">@color/accent_teal_secondary</item>
    </style>

    <style name="Theme.HexaPlayer.Pink" parent="Theme.HexaPlayer">
        <item name="colorPrimary">@color/accent_pink_primary</item>
        <item name="colorSecondary">@color/accent_pink_secondary</item>
    </style>

    <style name="Theme.HexaPlayer.Orange" parent="Theme.HexaPlayer">
        <item name="colorPrimary">@color/accent_orange_primary</item>
        <item name="colorSecondary">@color/accent_orange_secondary</item>
    </style>

    <!-- Termux setup guide -->
    <style name="TermuxStepCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_folder_row</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="TermuxStepLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorSecondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TermuxStepTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/colorText</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TermuxStepBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TermuxStepStatus">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
